[Unit]
Description=Diko's Finance FastAPI Backend
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/dikos-finance/backend
EnvironmentFile=/home/ubuntu/dikos-finance/backend/.env
ExecStart=/home/ubuntu/dikos-finance/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dikos-finance

[Install]
WantedBy=multi-user.target
